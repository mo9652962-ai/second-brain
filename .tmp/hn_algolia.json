61,49557308,49558499],"created_at":"2026-09-03T15:36:43Z","created_at_i":1788449803,"num_comments":86,"objectID":"49551760","points":270,"story_id":49551760,"title":"K2 Horizon: A connected fleet of six open models","updated_at":"2026-09-04T03:43:03Z","url":"https://ifm.ai/blog/k2/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"feb"},"story_text":{"matchLevel":"none","matchedWords":[],"value":"<a href=\"https://www.ycombinator.com/library/Y6-the-world-s-largest-electric-aircraft-just-flew\">https://www.ycombinator.com/library/Y6-the-world-s-largest-e...</a>"},"title":{"matchLevel":"none","matchedWords":[],"value":"The largest electric aircraft just flew [video]"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://www.youtube.com/watch?v=nM86DBOqgPM"}},"_tags":["story","author_feb","story_49526453","front_page"],"author":"feb","children":[49526454,49526730,49527300,49527772,49556352,49556462,49556746,49557031,49557266,49557276,49557427,49557617,49557812,49557899,49558152,49558198,49558254,49558864,49558880,49558899,49559066,49559316,49559679,49560087,49560110,49560248],"created_at":"2026-09-01T19:02:34Z","created_at_i":1788289354,"num_comments":154,"objectID":"49526453","points":220,"story_id":49526453,"story_text":"<a href=\"https:&#x2F;&#x2F;www.ycombinator.com&#x2F;library&#x2F;Y6-the-world-s-largest-electric-aircraft-just-flew\">https:&#x2F;&#x2F;www.ycombinator.com&#x2F;library&#x2F;Y6-the-world-s-largest-e...</a>","title":"The largest electric aircraft just flew [video]","updated_at":"2026-09-04T03:42:18Z","url":"https://www.youtube.com/watch?v=nM86DBOqgPM"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"rabahs"},"story_text":{"matchLevel":"none","matchedWords":[],"value":"These are my notes from porting my Amiga game, which I originally built in Baghdad in 1993 in MC68000 assembly, to Godot, using Claude Fable 5 during last July holiday.  It took an evening! Getting the feel right and shipping it took a few more weekends and evenings.<p>I spent the last few weeks analyzing what Claude did, feeding it my 33 years of memory of how I built the game, my notes and the git repos. It wrote the first draft of the article, and I edited line by line over a week. The screenshots of my 1993 map editor is the first I have run it since then. The one thing I never verified myself is the 108-byte explanation.<p>&quot;Before starting everything, the model assembled the code using vasm on my Mac, and kept going till the binary is byte-identical to the binaries I had in my original game. Even after that, the there was mismatch of about 108 bytes. I originally used AsmOne  which assembles into memory, and the game saved into the disk by saving that memory after running the game. So the original shipped files are a snapshot of the game that had already been running, not clean asm-one output.&quot;<p>Please post any questions. I am also releasing the original game for free."},"title":{"matchLevel":"none","matchedWords":[],"value":"Porting my 1993 Amiga game to Godot, with an LLM reading the 68000 assembly"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://babyloniantwins.com/blog/porting-a-1993-amiga-game-to-godot/"}},"_tags":["story","author_rabahs","story_49550375","front_page"],"author":"rabahs","children":[49550384,49550941,49554255,49554365,49554421,49554582,49554831,49554873,49554889,49554971,49555833,49556092,49557064,49557188,49557365,49557441,49557461,49557790,49558465,49558505,49559283,49559383,49559423,49559444,49559840,49560222],"created_at":"2026-09-03T14:28:18Z","created_at_i":1788445698,"num_comments":66,"objectID":"49550375","points":220,"story_id":49550375,"story_text":"These are my notes from porting my Amiga game, which I originally built in Baghdad in 1993 in MC68000 assembly, to Godot, using Claude Fable 5 during last July holiday.  It took an evening! Getting the feel right and shipping it took a few more weekends and evenings.<p>I spent the last few weeks analyzing what Claude did, feeding it my 33 years of memory of how I built the game, my notes and the git repos. It wrote the first draft of the article, and I edited line by line over a week. The screenshots of my 1993 map editor is the first I have run it since then. The one thing I never verified myself is the 108-byte explanation.<p>&quot;Before starting everything, the model assembled the code using vasm on my Mac, and kept going till the binary is byte-identical to the binaries I had in my original game. Even after that, the there was mismatch of about 108 bytes. I originally used AsmOne  which assembles into memory, and the game saved into the disk by saving that memory after running the game. So the original shipped files are a snapshot of the game that had already been running, not clean asm-one output.&quot;<p>Please post any questions. I am also releasing the original game for free.","title":"Porting my 1993 Amiga game to Godot, with an LLM reading the 68000 assembly","updated_at":"2026-09-04T03:41:48Z","url":"https://babyloniantwins.com/blog/porting-a-1993-amiga-game-to-godot/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"gmays"},"title":{"matchLevel":"none","matchedWords":[],"value":"Go grandmaster Shin defeats AI KataGo with a two-stone handicap"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://www.kedglobal.com/artificial-intelligence/newsView/ked202607210007"}},"_tags":["story","author_gmays","story_49544762","front_page"],"author":"gmays","children":[49545229,49545498,49545736,49546431,49549532,49555398,49555790,49556112,49556270,49556696,49556730,49556870,49557962,49558095,49558202,49559027,49559144,49559886,49559996,49560282],"created_at":"2026-09-03T01:11:22Z","created_at_i":1788397882,"num_comments":65,"objectID":"49544762","points":217,"story_id":49544762,"title":"Go grandmaster Shin defeats AI KataGo with a two-stone handicap","updated_at":"2026-09-04T03:43:49Z","url":"http